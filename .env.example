# ==========================================
# BACKEND ENVIRONMENT VARIABLES (RENDER)
# ==========================================

# Required: Google Gemini API Key for LLM chat and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (used as fallback if Gemini is not provided)
OPENAI_API_KEY=your_openai_api_key_here

# Required: MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.uwbtb0u.mongodb.net/rag_chatbot?retryWrites=true&w=majority

# Required: JWT Configuration for authentication
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_ALGORITHM=HS256

# Required: Frontend Origin for CORS (set to your Vercel URL on production)
# Example: https://rag-chatbot.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Optional: Port (Render will automatically set this to 10000)
PORT=8000


# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (VERCEL)
# ==========================================

# Required on Vercel: Render Backend Service URL (without trailing slash)
# Example: https://rag-chatbot-backend.onrender.com
VITE_API_URL=https://rag-chatbot-backend.onrender.com
